# =============================================================
# IRIS Regulação - Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# NUNCA commite .env.local no git
# =============================================================

# Supabase
# Obtenha em: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Apenas server-side - NUNCA use NEXT_PUBLIC_ aqui
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Admin/Auth
# E-mail global/owner da plataforma. Se configurado, somente este e-mail entra no sistema.
IRIS_OWNER_EMAIL=admin@empresa.com

# Código opcional para liberar a tela temporária /setup-owner.
IRIS_SETUP_TOKEN=gere-um-codigo-temporario

# Compatibilidade: lista opcional de e-mails administrativos adicionais.
ADMIN_EMAILS=

# Vercel Cron envia Authorization: Bearer $CRON_SECRET quando configurado.
CRON_SECRET=gere-um-segredo-longo

# OCR externo OPCIONAL para PDFs escaneados (OCR.space — tem tier grátis).
# Sem a chave, escaneados seguem sinalizados para revisão manual (sem OCR).
# Após ativar, reprocesse os escaneados antigos em Upload → Reprocessar.
OCR_SPACE_API_KEY=

# Trigger.dev
# Obtenha em: https://cloud.trigger.dev
TRIGGER_SECRET_KEY=tr_dev_...
